# Copy this file to .env and fill in what you need.
# Nothing here is required to boot the app — sensible local defaults are used.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (SQLite file, zero setup — good fit for local dev on modest hardware)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/cognitive_interview.db

# ---------------------------------------------------------------------------
# LLM provider — swappable at runtime, no code change.
# LLM_PROVIDER = "cloud" | "local"
#
#   cloud  answer analysis takes ~5s. Needs an API key and internet.
#   local  fully offline via Ollama, but ~90s per answer on CPU. Use this if
#          you need a no-internet demo, or you have a working GPU setup.
# ---------------------------------------------------------------------------
LLM_PROVIDER=cloud

# --- cloud: any OpenAI-compatible /chat/completions endpoint ---
# Groq (recommended — fast, generous free tier). Get a key at console.groq.com:
LLM_CLOUD_BASE_URL=https://api.groq.com/openai/v1
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=openai/gpt-oss-120b
#
# Providers retire model names regularly. If you get a 404 saying the model
# doesn't exist, list what your key can actually reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"
#
# Other providers work too — only these two lines change:
#   OpenAI      LLM_CLOUD_BASE_URL=https://api.openai.com/v1        MODEL=gpt-4o-mini
#   Gemini      LLM_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter  LLM_CLOUD_BASE_URL=https://openrouter.ai/api/v1

# --- local: Ollama ---
# Native: install Ollama, then `ollama pull qwen2.5:3b-instruct`.
# Docker: use `docker compose --profile local-llm up` and the model is pulled
# for you. Leave this URL as localhost — compose overrides it internally.
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=qwen2.5:3b-instruct

# ---------------------------------------------------------------------------
# Speech-to-text — local by default (faster-whisper). "tiny"/"base" fit modest
# hardware; step up to "small" only if you have RAM/GPU headroom to spare.
# ---------------------------------------------------------------------------
STT_PROVIDER=local
STT_LOCAL_MODEL_SIZE=base
STT_LOCAL_DEVICE=cpu
STT_LOCAL_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Text-to-speech — Google Cloud TTS free tier (as requested). Falls back to a
# silent/local stub automatically if no credentials are configured, so the
# app still boots and is testable without a Google account.
# ---------------------------------------------------------------------------
TTS_PROVIDER=google_cloud
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE_CODE=en-US

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./storage/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Interview flow tuning
# ---------------------------------------------------------------------------
HINT_AFTER_SECONDS=15
AUTO_RECORD_AFTER_SECONDS=20
DIFFICULTY_MIN=1
DIFFICULTY_MAX=5
