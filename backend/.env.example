# Copy this file to .env and fill in what you need.
# Nothing here is required to boot the app — sensible local defaults are used.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (SQLite file, zero setup — good fit for local dev on modest hardware)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/cognitive_interview.db

# ---------------------------------------------------------------------------
# LLM provider — the whole point is this is swappable at runtime via env var.
# LLM_PROVIDER = "local" | "cloud"
# ---------------------------------------------------------------------------
LLM_PROVIDER=local

# "local" -> talks to Ollama's HTTP API. Install Ollama, then:
#   ollama pull qwen2.5:3b-instruct     (good fit for 8GB RAM / GTX 1650 4GB)
#   ollama pull phi3.5:3.8b-mini-instruct-q4_0   (alternative, slightly smaller)
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=qwen2.5:3b-instruct

# "cloud" -> any OpenAI-compatible chat completions endpoint (OpenAI itself,
# or a compatible provider e.g. Groq/Together/OpenRouter/Google's OpenAI-compat endpoint).
LLM_CLOUD_BASE_URL=https://api.openai.com/v1
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Speech-to-text — local by default (faster-whisper). "tiny"/"base" fit modest
# hardware; step up to "small" only if you have RAM/GPU headroom to spare.
# ---------------------------------------------------------------------------
STT_PROVIDER=local
STT_LOCAL_MODEL_SIZE=base
STT_LOCAL_DEVICE=cpu
STT_LOCAL_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Text-to-speech — Google Cloud TTS free tier (as requested). Falls back to a
# silent/local stub automatically if no credentials are configured, so the
# app still boots and is testable without a Google account.
# ---------------------------------------------------------------------------
TTS_PROVIDER=google_cloud
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE_CODE=en-US

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./storage/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Interview flow tuning
# ---------------------------------------------------------------------------
HINT_AFTER_SECONDS=15
AUTO_RECORD_AFTER_SECONDS=20
DIFFICULTY_MIN=1
DIFFICULTY_MAX=5
